---
// Rama decorativa: un tallo a mano alzada, como las plantas del local, que se abre en ramitas.
// Cada ramita acaba en un nodo, como un circuito. Se dibuja sola cuando entra en pantalla (data-reveal).
// Sin JavaScript, o con «reducir movimiento», se ve ya dibujada.
interface Props { class?: string; flip?: boolean; }
const { class: className, flip = false } = Astro.props;
// Ramitas: trazo y nodo final [x, y]
const twigs: [string, [number, number]][] = [
  ['M118 214 C 120 188, 132 172, 152 162 L 176 162', [182, 162]],
  ['M196 156 C 204 128, 222 112, 246 108', [252, 108]],
  ['M246 108 L 270 84 L 300 84', [306, 84]],
  ['M276 92 C 288 70, 300 56, 322 50', [328, 50]],
  ['M160 188 L 188 206 L 220 206', [226, 206]],
  ['M296 70 L 324 98 L 354 98', [360, 98]],
];
// Hojas: posición, giro y tamaño
const leaves: [number, number, number, number][] = [
  [86, 236, -40, 1], [140, 196, 30, .85], [212, 140, -55, .9], [232, 128, 40, .7], [306, 66, -30, .8], [178, 178, 70, .7],
];
---
<svg class:list={['branch', { 'branch--flip': flip }, className]} viewBox="0 0 380 300" aria-hidden="true" focusable="false" data-reveal>
  <g fill="none" stroke-linecap="round" stroke-linejoin="round">
    <path class="branch-stem" pathLength="1" d="M2 298 C 40 270, 70 250, 104 226 C 150 194, 190 164, 222 128 C 248 98, 276 74, 340 30" stroke="var(--verde-tinta)" stroke-width="2.2" />
    {twigs.map(([d], i) => <path class="branch-twig" pathLength="1" d={d} stroke="var(--verde-tinta)" stroke-width="1.5" style={`--i:${i}`} />)}
  </g>
  {leaves.map(([x, y, r, s], i) => <path class="branch-leaf" d="M0 0 C 6 -9, 20 -10, 28 0 C 20 10, 6 9, 0 0 Z" transform={`translate(${x} ${y}) rotate(${r}) scale(${s * 1.35})`} fill="var(--verde-tinta)" fill-opacity=".85" style={`--i:${i}`} />)}
  {twigs.map(([, [x, y]], i) => <g class="branch-node" style={`--i:${i}`}><circle cx={x} cy={y} r="5.5" fill="var(--papel)" stroke="var(--mostaza)" stroke-width="1.6" /><circle cx={x} cy={y} r="2.2" fill="var(--mostaza)" /></g>)}
  <circle class="branch-node" cx="340" cy="30" r="4" fill="var(--mostaza)" style="--i:6" />
</svg>
