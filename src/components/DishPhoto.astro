---
import { url } from '../lib/base';
// Foto de un plato de la carta oficial (optimizada por npm run carta).
interface Foto { src: string; width: number; height: number; widths: number[]; }
interface Props { foto: Foto; alt: string; sizes: string; class?: string; eager?: boolean; }
const { foto, alt, sizes, class: className, eager = false } = Astro.props;
const srcset = (ext: string) => foto.widths.map(w => `${url(foto.src)}-${w}.${ext} ${w}w`).join(', ');
---
<picture class={className}>
  <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
  <img src={`${url(foto.src)}-${foto.widths.at(-1)}.webp`} srcset={srcset('webp')} sizes={sizes} width={foto.width} height={foto.height} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
</picture>
