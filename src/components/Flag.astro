---
// Bandera del idioma en SVG propio: los emojis de bandera no se ven en Windows.
// Inglés usa la bandera del Reino Unido.
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang; class?: string; }
const { lang, class: className } = Astro.props;
// Cada bandera británica necesita sus propios recortes cuando hay varias en la página.
const g = globalThis as typeof globalThis & { __flagCount?: number };
const uid = `flag-${(g.__flagCount = (g.__flagCount ?? 0) + 1)}`;
---
<svg class:list={['flag', className]} viewBox="0 0 30 20" width="21" height="14" aria-hidden="true" focusable="false" preserveAspectRatio="xMidYMid slice">
  {lang === 'es' && <Fragment><rect width="30" height="20" fill="#AA151B" /><rect y="5" width="30" height="10" fill="#F1BF00" /></Fragment>}
  {lang === 'de' && <Fragment><rect width="30" height="20" fill="#000" /><rect y="6.67" width="30" height="6.67" fill="#DD0000" /><rect y="13.33" width="30" height="6.67" fill="#FFCE00" /></Fragment>}
  {lang === 'nl' && <Fragment><rect width="30" height="20" fill="#AE1C28" /><rect y="6.67" width="30" height="6.67" fill="#FFF" /><rect y="13.33" width="30" height="6.67" fill="#21468B" /></Fragment>}
  {lang === 'en' && <svg x="-5" width="40" height="20" viewBox="0 0 60 30">
    <clipPath id={`${uid}-s`}><path d="M0,0 v30 h60 v-30 z" /></clipPath>
    <clipPath id={`${uid}-t`}><path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z" /></clipPath>
    <g clip-path={`url(#${uid}-s)`}>
      <path d="M0,0 v30 h60 v-30 z" fill="#012169" />
      <path d="M0,0 L60,30 M60,0 L0,30" stroke="#FFF" stroke-width="6" />
      <path d="M0,0 L60,30 M60,0 L0,30" clip-path={`url(#${uid}-t)`} stroke="#C8102E" stroke-width="4" />
      <path d="M30,0 v30 M0,15 h60" stroke="#FFF" stroke-width="10" />
      <path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6" />
    </g>
  </svg>}
</svg>
