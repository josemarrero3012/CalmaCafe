---
import { url } from '../lib/base';
// Dibujo a mano de cada sección de la carta, como una pegatina junto a la foto en arco.
// La sección se reconoce por el final de su id (carta-brunch, vegano-algo-dulce…); si no hay dibujo, no pinta nada.
// El sándwich, el huevo, el aguacate, las tortitas, la taza y el vaso son ilustraciones aparte (public/media/dibujos),
// metidas en la misma pegatina; el globo de los niños se dibuja aquí en SVG.
interface Props { grupo: string; class?: string; }
const { grupo, class: className } = Astro.props;
const tipos = ['brunch-tardio-mas', 'para-los-ninos', 'algo-dulce', 'bebidas-frias', 'bebidas-calientes', 'extras', 'brunch'] as const;
const tipo = tipos.find(t => grupo.endsWith(t));
// Caja de cada ilustración dentro de la pegatina (viewBox 120×120), centrada y con la proporción de la imagen.
const dibujos: Partial<Record<typeof tipos[number], { src: string; x: number; y: number; w: number; h: number }>> = {
  'brunch': { src: 'huevo-240.webp', x: 20, y: 26, w: 80, h: 68 },
  'brunch-tardio-mas': { src: 'sandwich-240.webp', x: 17, y: 27, w: 86, h: 66 },
  'extras': { src: 'aguacate-240.webp', x: 28.5, y: 18, w: 63, h: 84 },
  'algo-dulce': { src: 'tortitas-240.webp', x: 18, y: 27, w: 84, h: 67 },
  'bebidas-calientes': { src: 'taza-240.webp', x: 28.9, y: 18, w: 62.3, h: 84 },
  'bebidas-frias': { src: 'vaso-240.webp', x: 32, y: 18, w: 56, h: 84 },
};
const dibujo = tipo && dibujos[tipo];
---
{tipo && <svg class:list={['group-doodle', className]} viewBox="0 0 120 120" aria-hidden="true" focusable="false" fill="none" stroke="#1E1A1A" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
  <circle cx="60" cy="60" r="56" fill="#FFFDF7" stroke="none" />
  <circle cx="60" cy="60" r="50" stroke="#CE9628" stroke-width="1.4" stroke-dasharray="1 6" />
  {dibujo && <image href={url(`/media/dibujos/${dibujo.src}`)} x={dibujo.x} y={dibujo.y} width={dibujo.w} height={dibujo.h} />}
  {tipo === 'para-los-ninos' && <g>
    {/* Globo con su cordel */}
    <path d="M60 22 C 78 22, 86 38, 84 50 C 82 64, 70 72, 60 74 C 50 72, 38 64, 36 50 C 34 38, 42 22, 60 22 Z" fill="#C9808C" />
    <path d="M48 34 C 52 30, 56 29, 60 29" stroke="#FFFDF7" stroke-width="2.4" />
    <path d="M56 74 L 64 74 L 60 80 Z" fill="#C9808C" />
    <path d="M60 80 C 52 88, 68 92, 58 100" stroke-width="1.8" />
  </g>}
</svg>}
