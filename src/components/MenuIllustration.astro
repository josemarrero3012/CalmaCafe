---
import { url } from '../lib/base';
// Dibujo de «la carta» para la cabecera de la Carta: una carta en arco sobre azulejo salvia, pancakes, una taza
// humeante y una hoja. En español se usa el dibujo con la palabra «Carta» a mano; en los otros idiomas, la misma
// imagen sin la palabra y el nombre escrito encima con la letra manuscrita de la web.
interface Props { label: string; class?: string; }
const { label, class: className } = Astro.props;
const version = label === 'Carta' ? 'carta-es' : 'carta-blank';
const widths = [400, 800, 1200];
const srcset = (ext: string) => widths.map(w => `${url(`/media/dibujos/${version}-${w}.${ext}`)} ${w}w`).join(', ');
const sizes = '400px';
// Tamaño en % del ancho del dibujo: las palabras largas («Speisekarte») se escriben más pequeñas para caber en la carta.
const fontSize = Math.min(10, 62 / label.length);
---
<div class:list={['menu-illustration', className]} aria-hidden="true">
  <picture>
    <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
    <img src={url(`/media/dibujos/${version}-800.webp`)} srcset={srcset('webp')} sizes={sizes} width="1305" height="969" alt="" decoding="async" fetchpriority="high" />
  </picture>
  {version === 'carta-blank' && <span class="menu-illustration-label" style={`font-size:${fontSize}cqw`}>{label}</span>}
</div>
