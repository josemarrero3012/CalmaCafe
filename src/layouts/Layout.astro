---
import Icon from '../components/Icon.astro';
import '../styles/global.css';
import Lotus from '../components/Lotus.astro';
import Flag from '../components/Flag.astro';
import negocio from '../data/negocio.json';
import { url } from '../lib/base';
import { langs, locale, phone, routes, ui, type Lang, type Page } from '../i18n/ui';
// Sin `current` (página 404): no hay versiones traducidas, así que el selector de idioma lleva a cada inicio.
interface Props { lang: Lang; title: string; description: string; current?: Page; }
const { lang, title, description, current } = Astro.props;
const t = ui[lang];
const pages = (Object.keys(routes[lang]) as Page[]).map(id => ({ id, href: url(routes[lang][id]), label: t.nav[id] }));
const ariaCurrent = (id: Page) => (id === current ? 'page' : undefined);
const langHref = (other: Lang) => url(routes[other][current ?? 'inicio']);
// El indicador «Abierto/Cerrado» solo aparece con el horario real confirmado (y por ahora solo en español).
const showHours = negocio.horario.confirmado && lang === 'es';
const schema = { '@context': 'https://schema.org', '@type': 'CafeOrCoffeeShop', name: negocio.nombre, slogan: negocio.lema, servesCuisine: ['Brunch', 'Coffee'], telephone: negocio.telefono.enlace.replace('tel:', ''), sameAs: [negocio.instagram.url], address: { '@type': 'PostalAddress', streetAddress: `${negocio.direccion.calle}, ${negocio.direccion.edificio}`, addressLocality: negocio.localidad, addressRegion: negocio.isla, addressCountry: 'ES' } };
---
<!doctype html>
<html lang={locale[lang].html}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FAF6EF" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale[lang].og} />
    {langs.filter(other => other !== lang).map(other => <meta property="og:locale:alternate" content={locale[other].og} />)}
    {/* Rutas relativas hasta que haya dominio (Fase 4): entonces, `site` en astro.config y URLs absolutas. */}
    {current ? <>
      {langs.map(other => <link rel="alternate" hreflang={locale[other].html} href={Astro.site ? new URL(url(routes[other][current]), Astro.site).href : url(routes[other][current])} />)}
      <link rel="alternate" hreflang="x-default" href={Astro.site ? new URL(url(routes.es[current]), Astro.site).href : url(routes.es[current])} />
    </> : <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="preload" href={url('/fonts/fraunces.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={url('/fonts/dm-sans.woff2')} as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body data-page={current ?? 'error'}>
    <a href="#contenido" class="skip-link">{t.skip}</a>
    <header class="site-header">
      <div class="header-inner wrap">
        <a class="brand" href={url(routes[lang].inicio)} aria-label={t.homeLabel} aria-current={ariaCurrent('inicio')}><img src={url('/media/logo-dark.svg')} alt="Calma · Cafe · Feed your soul" width="950" height="540" /></a>
        <nav class="desktop-nav" aria-label={t.navLabel}>
          {pages.map(page => <a href={page.href} aria-current={ariaCurrent(page.id)}>{page.label}</a>)}
        </nav>
        <div class="header-actions">
          {showHours
            ? <a class="hours-indicator" href={`${url(routes[lang].visitanos)}#horario`}><span class="status"><span class="status-dot"></span><span data-hours>{negocio.horario.texto}</span></span></a>
            : <a class="header-phone" href={negocio.telefono.enlace}><span aria-hidden="true"><Icon name="phone" /></span> {phone(lang, negocio.telefono.texto)}</a>}
          <details class="lang-switch">
            <summary aria-label={`${t.language}: ${locale[lang].name}`}><Flag lang={lang} /><span>{lang.toUpperCase()}</span></summary>
            <ul>
              {langs.map(other => <li><a href={langHref(other)} hreflang={locale[other].html} lang={locale[other].html} aria-current={other === lang ? 'true' : undefined}><Flag lang={other} />{locale[other].name}</a></li>)}
            </ul>
          </details>
          <a class="button button-small desktop-directions" href={negocio.mapas.url} target="_blank" rel="noopener noreferrer">{t.directions} <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a>
          <button class="menu-toggle" type="button" aria-label={t.openMenu} aria-haspopup="dialog" aria-controls="mobile-menu"><span></span><span></span></button>
        </div>
      </div>
      {showHours && <a class="mobile-hours" href={`${url(routes[lang].visitanos)}#horario`}><span data-hours>{negocio.horario.texto}</span></a>}
    </header>
    <dialog id="mobile-menu" class="mobile-menu" aria-labelledby="mobile-menu-title">
      <div class="mobile-menu-top"><span id="mobile-menu-title" class="eyebrow">{t.menu}</span><button class="icon-button" data-close aria-label={t.closeMenu}><Icon name="close" /></button></div>
      <nav aria-label={t.mobileNavLabel}>{pages.map((page, i) => <a href={page.href} aria-current={ariaCurrent(page.id)}>{page.label} <span>0{i + 1}</span></a>)}</nav>
      <ul class="menu-langs" aria-label={t.language}>
        {langs.map(other => <li><a href={langHref(other)} hreflang={locale[other].html} lang={locale[other].html} aria-current={other === lang ? 'true' : undefined}><Flag lang={other} />{locale[other].name}</a></li>)}
      </ul>
      <address class="menu-contact">
        <span>{negocio.direccion.calle} · {negocio.direccion.edificio}<br />{negocio.localidad}, {negocio.isla}</span>
        <a href={negocio.telefono.enlace}>{phone(lang, negocio.telefono.texto)}</a>
        <a href={negocio.whatsapp.url} target="_blank" rel="noopener noreferrer">WhatsApp <Icon name="arrow-up-right" /></a>
        <a href={negocio.instagram.url} target="_blank" rel="noopener noreferrer">{negocio.instagram.usuario} <Icon name="arrow-up-right" /></a>
      </address>
    </dialog>

    <main id="contenido">
      <slot />
    </main>

    <footer class="site-footer"><div class="tile-border" aria-hidden="true"></div><div class="wrap">
      <div class="footer-top">
        <a class="footer-brand" href={url(routes[lang].inicio)} aria-label={t.backHome}><img src={url('/media/logo-dark.svg')} alt="Calma Café · Feed your soul" width="950" height="540" /></a>
        <div><span class="eyebrow">{t.whereWeAre}</span><span>{negocio.direccion.calle}<br />{negocio.direccion.edificio}<br />{negocio.localidad}, {negocio.isla}</span><a class="footer-link" href={negocio.mapas.url} target="_blank" rel="noopener noreferrer">{t.directions} <Icon name="arrow-up-right" /></a></div>
        <div><span class="eyebrow">{t.contact}</span><a class="footer-link" href={negocio.telefono.enlace}>{phone(lang, negocio.telefono.texto)}</a><a class="footer-link" href={negocio.whatsapp.url} target="_blank" rel="noopener noreferrer">WhatsApp <Icon name="arrow-up-right" /></a><a class="footer-link" href={negocio.instagram.url} target="_blank" rel="noopener noreferrer">{negocio.instagram.usuario} <Icon name="arrow-up-right" /></a></div>
        <a href="#contenido" class="back-top" aria-label={t.backTop}><Icon name="arrow-up" /></a>
      </div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} {negocio.nombre} · {negocio.lema}</span><nav aria-label={t.legalNav}>{(['legal', 'privacy', 'cookies'] as const).map(key => <button data-notice data-notice-title={t.notices[key][0]} data-notice-text={t.notices[key][1]}>{t[key]}</button>)}</nav><span>{t.proposal}</span></div>
    </div></footer>

    <nav class="mobile-bottom" aria-label={t.quickActions}><a href={negocio.mapas.url} target="_blank" rel="noopener noreferrer"><span aria-hidden="true"><Icon name="arrow-up-right" /></span> {t.directions}</a><a href={negocio.telefono.enlace}><span aria-hidden="true"><Icon name="phone" /></span> {t.call}</a></nav>
    <dialog id="notice-dialog" class="notice-dialog" aria-labelledby="notice-title"><button class="icon-button" data-close aria-label={t.close}><Icon name="close" /></button><Lotus /><h2 id="notice-title"></h2><p id="notice-description"></p><a class="text-link" href={negocio.instagram.url} target="_blank" rel="noopener noreferrer">{negocio.instagram.usuario} {t.onInstagram} <Icon name="arrow-up-right" /></a><button class="button" data-close>{t.ok}</button></dialog>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
