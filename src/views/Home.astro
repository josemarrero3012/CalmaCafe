---
import { url } from '../lib/base';
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import DishPhoto from '../components/DishPhoto.astro';
import Lotus from '../components/Lotus.astro';
import Seal from '../components/Seal.astro';
import ScriptWord from '../components/ScriptWord.astro';
import negocio from '../data/negocio.json';
import carta from '../data/carta.json';
import { locale, phone, price, routes, tc, ui, type Lang } from '../i18n/ui';
import { contar, destacados } from '../lib/carta';
import { huecos } from '../lib/destacados.mjs';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = ui[lang];
const h = t.home;
// Solo se destacan platos y bebidas que están en la carta oficial; si uno desaparece, destacados.mjs elige otro de su sección.
const { fotos: { dulce, salado: especial, cafe: latteFrio, matcha: matchaLatte }, bebidas } = destacados;
// El texto alternativo largo describe la foto de los Pancakes; con otro plato basta su nombre.
const dulceAlt = dulce.id === huecos.dulce.ids[0] ? h.pancakesAlt : tc(lang, dulce.nombre);
const fill = (text: string) => text.replace('{n}', String(carta.menus.reduce((n, menu) => n + contar(menu), 0))).replace('{calle}', negocio.direccion.calle).replace('{tel}', phone(lang, negocio.telefono.texto));
const doors = [
  { href: url(routes[lang].carta), dish: especial, text: h.doors.carta },
  { href: url(routes[lang].calma), photo: 'interior-cojines', text: h.doors.calma },
  { href: url(routes[lang].visitanos), photo: 'interior-ventanal', text: h.doors.visit },
] as const;
---
<Layout lang={lang} current="inicio" title={h.title} description={h.description}>
  {/* Hero editorial sobre papel: el texto a la izquierda y el local dentro de un arco, como las fotos de la carta */}
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-inner wrap">
      <div class="hero-copy">
        <p class="eyebrow enter"><span class="little-sun" aria-hidden="true"><Icon name="sun" /></span> {h.place}</p>
        <h1 id="hero-title" class="enter enter-2" set:html={h.h1} />
        <div class="hero-script enter enter-2">
          <ScriptWord text="Feed your soul" class="script-hero" />
          <svg class="hero-flourish" viewBox="0 0 520 36" aria-hidden="true" focusable="false"><path d="M4 31 C 130 17 320 8 516 3 C 322 13 140 25 12 35 C 7 35 3 33 4 31 Z" /></svg>
        </div>
        <p class="hero-intro enter enter-3">{h.intro}</p>
        <div class="hero-buttons enter enter-3"><a class="button button-green" href={url(routes[lang].carta)}>{h.seeMenu} <span aria-hidden="true"><Icon name="arrow-right" /></span></a><button class="video-open" type="button" aria-haspopup="dialog" aria-controls="video-dialog" aria-label={t.video.play}><span aria-hidden="true">▶︎</span> {t.video.playShort}</button><a class="text-link hero-directions" href={negocio.mapas.url} target="_blank" rel="noopener noreferrer">{t.directions} <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div>
        {negocio.google.nota && <a class="hero-rating enter enter-3" href={negocio.mapas.ficha} target="_blank" rel="noopener noreferrer"><span class="hero-stars" aria-hidden="true">★★★★★</span> {h.rating(new Intl.NumberFormat(locale[lang].intl, { minimumFractionDigits: 1 }).format(negocio.google.nota))} <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a>}
      </div>
      <div class="hero-visual enter enter-visual">
        <div class="hero-arch"><Photo name="interior-barra" lang={lang} sizes="(max-width: 699px) 80vw, 460px" eager priority /></div>
        <Seal />
        <figure class="hero-photo"><DishPhoto foto={dulce.foto} alt={dulceAlt} sizes="(max-width: 699px) 150px, 260px" eager /><figcaption class="handwritten">{tc(lang, dulce.nombre)} · {price(lang, dulce.precio)}</figcaption></figure>
        <figure class="hero-photo hero-photo--salty"><DishPhoto foto={especial.foto} alt={tc(lang, especial.nombre)} sizes="(max-width: 699px) 130px, 200px" eager /><figcaption class="handwritten">{tc(lang, especial.nombre)} · {price(lang, especial.precio)}</figcaption></figure>
      </div>
    </div>
  </section>

  <dialog id="video-dialog" class="video-dialog" aria-label={t.video.label}>
    <button class="icon-button video-dialog-close" data-close aria-label={t.close}><Icon name="close" /></button>
    <video id="interior-video" controls muted loop playsinline preload="none" poster={url('/media/interior-poster-480.webp')} width="432" height="768">
      <source data-src={url('/media/interior.webm')} type="video/webm" /><source data-src={url('/media/interior.mp4')} type="video/mp4" />
    </video>
  </dialog>

  {/* Cinta en movimiento: dos mitades idénticas que se desplazan un 50 % para enlazar sin saltos */}
  <div class="welcome-strip" aria-hidden="true"><div class="welcome-track">
    {[0, 1].map(() => <div class="welcome-half">{[0, 1, 2].flatMap(() => h.strip).map(item => <Fragment><span>{item}</span><Lotus light /></Fragment>)}</div>)}
  </div></div>

  <section id="descubre" class="doors section" aria-labelledby="doors-title">
    <div class="wrap">
      <div class="section-heading" data-reveal><h2 id="doors-title" set:html={h.doorsTitle} /></div>
      <div class="doors-grid">
        {doors.map((door, i) => <a class="door" href={door.href} data-reveal>
          <div class="door-image">{'dish' in door ? <DishPhoto foto={door.dish.foto} alt={tc(lang, door.dish.nombre)} sizes="(max-width: 699px) 88vw, 30vw" /> : <Photo name={door.photo} lang={lang} sizes="(max-width: 699px) 88vw, 30vw" />}<span class="food-number">0{i + 1}</span></div>
          <h3>{door.text[0]}</h3><p>{fill(door.text[1])}</p><span class="text-link">{door.text[2]} <span aria-hidden="true"><Icon name="arrow-right" /></span></span>
        </a>)}
      </div>
    </div>
  </section>

  <section class="team-section section" aria-labelledby="team-title">
    <div class="wrap team-grid" data-choice="none">
      <div class="team-photos" data-reveal>
        <figure class="team-card team-card--coffee" data-team-pick="coffee"><DishPhoto foto={latteFrio.foto} alt={tc(lang, latteFrio.nombre)} sizes="(max-width: 600px) 62vw, 340px" /><figcaption class="handwritten">{h.coffee}</figcaption></figure>
        <figure class="team-card team-card--matcha" data-team-pick="matcha"><DishPhoto foto={matchaLatte.foto} alt={tc(lang, matchaLatte.nombre)} sizes="(max-width: 600px) 62vw, 340px" /><figcaption class="handwritten">{h.matcha}</figcaption></figure>
      </div>
      <div class="team-copy" data-reveal><p class="eyebrow">{h.drinksEyebrow}</p><h2 id="team-title" set:html={h.drinksTitle} /><p>{h.drinksIntro}</p>
        <div class="team-choices" role="group" aria-label={h.chooseDrink}><button type="button" class="team-choice" data-team="coffee" aria-pressed="false">{h.coffee}</button><button type="button" class="team-choice" data-team="matcha" aria-pressed="false">{h.matcha}</button></div>
        <div class="team-results">
          <p class="team-hint handwritten"><span aria-hidden="true">↑ </span>{h.drinksHint}</p>
          {Object.entries(bebidas).map(([team, lista]) => <ul class="team-result" data-team-panel={team}>
            {lista.map((b, i) => <li style={`--i:${i}`}><span>{tc(lang, b.nombre)}{b.descripcion && b.descripcion.length < 40 && <small>{tc(lang, b.descripcion)}</small>}</span><b>{price(lang, b.precio)}</b></li>)}
          </ul>)}
        </div>
        <a class="text-link team-link" href={`${url(routes[lang].carta)}#bebidas`}>{h.allDrinks} <span aria-hidden="true"><Icon name="arrow-right" /></span></a>
      </div>
    </div>
  </section>

  <section class="visit-band section" aria-labelledby="visit-band-title"><div class="wrap visit-band-grid">
    <div data-reveal><p class="eyebrow">{t.whereWeAre}</p><h2 id="visit-band-title">{negocio.direccion.calle}</h2><p>{negocio.direccion.edificio} · {negocio.localidad}, {negocio.isla}. {h.tables}</p>
      {negocio.google.nota && <a class="rating" href={negocio.mapas.ficha} target="_blank" rel="noopener noreferrer"><span class="rating-star" aria-hidden="true">★</span> {h.rating(new Intl.NumberFormat(locale[lang].intl, { minimumFractionDigits: 1 }).format(negocio.google.nota))} <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a>}</div>
    <div class="visit-band-actions" data-reveal>
      <a class="button" href={negocio.mapas.url} target="_blank" rel="noopener noreferrer">{t.directions} <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a>
      <a class="text-link" href={negocio.telefono.enlace}>{fill(h.callNumber)}</a>
      <a class="text-link" href={negocio.whatsapp.url} target="_blank" rel="noopener noreferrer">WhatsApp <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a>
      <a class="text-link" href={negocio.mapas.url} target="_blank" rel="noopener noreferrer">{h.reviews} <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a>
    </div>
  </div></section>
</Layout>
